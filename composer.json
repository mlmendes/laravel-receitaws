{
    "name": "mlmendes/laravel-receitaws",
    "description": "Integrate a Laravel application to ReceitaWS API by Leads2b",
    "keywords": [
        "Lucas Mendes Martins",
        "laravel",
        "laravel-receitaws"
    ],
    "homepage": "https://github.com/mlmendes/laravel-receitaws",
    "license": "MIT",
    "authors": [
        {
            "name": "Lucas Mendes Martins",
            "email": "martinslmendes@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.4",
        "spatie/laravel-package-tools": "^1.93",
        "illuminate/contracts": "^13.20"
    },
    "require-dev": {
        "laravel/pint": "^1.29",
        "nunomaduro/collision": "^8.9",
        "larastan/larastan": "^3.10",
        "orchestra/testbench": "^11.1",
        "pestphp/pest": "^4.7",
        "pestphp/pest-plugin-arch": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.1",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "MLMendes\\LaravelReceitaWS\\": "src/",
            "MLMendes\\LaravelReceitaWS\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MLMendes\\LaravelReceitaWS\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@composer run prepare",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "analyse": "vendor/bin/phpstan analyse",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "MLMendes\\LaravelReceitaWS\\LaravelReceitaWSServiceProvider"
            ],
            "aliases": {
                "LaravelReceitaWS": "MLMendes\\LaravelReceitaWS\\Facades\\LaravelReceitaWS"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
